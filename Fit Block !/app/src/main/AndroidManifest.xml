<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Standard permissions for Play Store / Indus -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- REQUIRED for AdMob on Android 13+ (API 33+) - otherwise app may get rejected -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="FIT BLOCK"
        android:theme="@android:style/Theme.NoTitleBar"
        android:supportsRtl="true">

        <!-- 
          ADMOB APP ID - REPLACE THIS BEFORE PUBLISHING
          1. Go to admob.google.com -> Apps -> Add App
          2. Copy your real APP ID (looks like ca-app-pub-1234567890123456~1234567890)
          3. Paste it below replacing the test ID
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- Main Activity MUST have exported=true for Android 12+ (API 31+) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
